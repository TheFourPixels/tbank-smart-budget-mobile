{
  "openapi": "3.0.1",
  "info": {
    "title": "Goal Service API",
    "description": "Управление финансовыми целями",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://goal-service:8087",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/goals/{id}": {
      "get": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/GoalDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGoalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/GoalDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/goals": {
      "post": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGoalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/GoalDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/goals/{id}/contribute": {
      "post": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "contribute",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalContributionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/GoalDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/goals/completed": {
      "get": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "listCompleted",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 2100,
              "minimum": 2000,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 12,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GoalDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/goals/active": {
      "get": {
        "tags": [
          "goal-controller"
        ],
        "operationId": "listActive",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 2100,
              "minimum": 2000,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 12,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GoalDto"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateGoalRequest": {
        "required": [
          "deadline",
          "name",
          "targetAmount"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Название цели",
            "example": "Новый ноутбук"
          },
          "targetAmount": {
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "Целевая сумма",
            "example": 150000
          },
          "deadline": {
            "type": "string",
            "description": "Дата завершения (дедлайн)",
            "format": "date",
            "example": "2026-06-01"
          }
        },
        "description": "Запрос на создание финансовой цели"
      },
      "GoalDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "targetAmount": {
            "type": "number"
          },
          "savedAmount": {
            "type": "number"
          },
          "deadline": {
            "type": "string",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date"
          },
          "progressPercent": {
            "type": "integer",
            "format": "int32"
          },
          "daysLeft": {
            "type": "integer",
            "format": "int64"
          },
          "recommendedMonthly": {
            "type": "number"
          }
        }
      },
      "GoalContributionRequest": {
        "required": [
          "amount"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "minimum": 0,
            "exclusiveMinimum": true,
            "type": "number",
            "description": "Сумма взноса",
            "example": 5000
          }
        },
        "description": "Запрос на внесение средств в цель"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}